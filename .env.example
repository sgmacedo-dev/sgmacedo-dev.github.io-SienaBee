# Siena Bee — environment placeholders (never commit real secrets)
# Copy to .env locally if/when tooling needs them. GitHub Pages is static:
# client-side keys only belong in HTML if they are publishable site keys.

# Google reCAPTCHA v3 (site key is public; secret key stays server-side only)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google AdSense client (e.g. ca-pub-xxxxxxxx). Add only when approved.
ADSENSE_CLIENT=

# Analytics (Plausible/GA/etc.)
ANALYTICS_ID=

# Amazon Associates tracking tag (e.g. yourtag-20)
# Unverified teammate note: 4bee-20 — do NOT commit until Silvana confirms.
# Runtime placeholder lives in js/script.js → SienaBee.amazon.associateTag
AMAZON_ASSOCIATE_TAG=YOUR_ASSOCIATE_TAG

# Optional form endpoint (Formspree/Netlify/etc.)
CONTACT_FORM_ENDPOINT=
